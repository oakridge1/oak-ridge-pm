generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OFFICE
  FOREMAN
  TEAMMATE
}

enum CalendarRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum JobStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum CalendarEventType {
  MILESTONE
  TASK_DUE
  COMPLETION
  DAY_OFF
  CUSTOM
}

enum InspectionType {
  UNDERGROUND
  ROUGH_IN
  SERVICE
  FIRE_ALARM
  SPECIAL
  FINAL
}

enum InspectionResult {
  PASS
  FAIL
}

enum RfiStatus {
  OPEN
  ANSWERED
}

enum DocumentCategory {
  PLANS
  SPECIFICATIONS
  PERMITS
  SUBMITTALS
  SUBCONTRACTS
  INSPECTION_REPORTS
  CLOSEOUT
  MATERIAL_RECEIPTS
  STOCK_ORDERS
  OTHER
}

enum JobType {
  BID
  TIME_AND_MATERIALS
  ESTIMATE
}

enum InvoiceType {
  STANDARD
  AIA
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
}

enum EstimateStatus {
  DRAFT
  SENT
  AWARDED
  LOST
  ARCHIVED
}

// ── Auth models (NextAuth Prisma adapter) ────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(TEAMMATE)
  active        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  laborEntries   LaborEntry[]
  materials      Material[]
  photos         Photo[]
  notes          Note[]
  changeOrders   ChangeOrder[]
  foremanJobs    Job[]          @relation("ForemanJobs")
  createdJobs    Job[]          @relation("JobCreator")
  assignedTasks  Task[]         @relation("TaskAssignee")
  createdTasks   Task[]         @relation("TaskCreator")
  taskEvents     TaskEvent[]
  calendarEvents CalendarEvent[]
  savedTasks     SavedTask[]
  inspections    Inspection[]   @relation("InspectionCreator")
  rfis           Rfi[]          @relation("RfiSubmitter")
  documents      Document[]     @relation("DocumentUploader")
  invoices       Invoice[]      @relation("InvoiceCreator")
  calendarRequests         CalendarRequest[] @relation("CalendarRequestSubmitter")
  reviewedCalendarRequests CalendarRequest[] @relation("CalendarRequestReviewer")
  googleConnections        GoogleConnection[] @relation("GoogleConnectionAdmin")
  stockRequests            StockRequest[]
  stockOrders              StockOrder[]     @relation("StockOrderSender")
  userPermissions          UserPermission[] @relation("UserPermissions")
  grantedPermissions       UserPermission[] @relation("GrantedPermissions")
  approvalRequests         StockApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals        StockApprovalRequest[] @relation("ApprovalReviewer")
  estimatingPermission     Boolean                @default(false)
  createdEstimates         Estimate[]             @relation("EstimateCreatedBy")
  designFeeEstimates       Estimate[]             @relation("EstimateDesignFee")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Jobs ─────────────────────────────────────────────────────────────────────

model Job {
  id                String    @id @default(cuid())
  jobNumber         String    @unique
  jobName           String
  address           String?
  city              String?
  state             String?
  zip               String?
  gcCompany         String?
  gcContactName     String?
  gcPhone           String?
  gcEmail           String?
  ownerName         String?
  ownerPhone        String?
  ownerEmail        String?
  foremanId         String?
  scopeOfWork       String?   @db.Text
  contractStartDate DateTime?
  completionDate    DateTime?
  permitNumber      String?
  inspectionContact String?
  inspectionPhone   String?
  status            JobStatus @default(ACTIVE)
  jobType           JobType   @default(BID)
  contractValue     Decimal?  @db.Decimal(12, 2)
  laborBudgetHours  Float?
  materialBudget    Decimal?  @db.Decimal(12, 2)
  calendarColor     String?
  // Summary tab settings
  blendedLaborRate   Decimal?  @db.Decimal(10, 2)
  // Direct cost fields (Summary tab)
  subcontractorCost  Decimal?  @db.Decimal(12, 2)
  equipmentCost      Decimal?  @db.Decimal(12, 2)
  equipmentBillPct   Float?
  otherCosts         Json?
  // Markup percentages
  laborMarkupPct     Float?
  subMarkupPct       Float?
  equipmentMarkupPct Float?
  // Archive
  archived           Boolean   @default(false)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  foreman          User?             @relation("ForemanJobs", fields: [foremanId], references: [id])
  createdBy        User?             @relation("JobCreator", fields: [createdById], references: [id])
  laborEntries     LaborEntry[]
  materials        Material[]
  photos           Photo[]
  notes            Note[]
  changeOrders     ChangeOrder[]
  tasks            Task[]
  calendarEvents   CalendarEvent[]
  calendarRequests CalendarRequest[]
  payments         Payment[]
  invoices         Invoice[]
  inspections      Inspection[]
  rfis             Rfi[]
  documents        Document[]
  stockRequests    StockRequest[]
  stockOrders      StockOrder[]
  userPermissions  UserPermission[]
  stockApprovalRequests StockApprovalRequest[]
  estimate              Estimate?
}

// ── Invoices ──────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  jobId         String
  createdById   String
  invoiceNumber Int
  type          InvoiceType   @default(STANDARD)
  invoiceKind   String?       @default("PROGRESS_PAYMENT")
  googleSheetId String?
  date          DateTime
  periodTo      DateTime?
  applicationNo Int?
  status        InvoiceStatus @default(DRAFT)
  amount        Decimal       @db.Decimal(12, 2)
  retainagePct  Float?
  retainageHeld Decimal?      @db.Decimal(12, 2)
  lineItems     Json?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InvoiceCreator", fields: [createdById], references: [id])
  payments  Payment[]

  @@unique([jobId, invoiceNumber])
}

// ── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                       String   @id @default(cuid())
  jobId                    String
  invoiceId                String?
  date                     DateTime
  amount                   Decimal  @db.Decimal(12, 2)
  checkNumber              String?
  reference                String?
  includesRetainageRelease Boolean  @default(false)
  note                     String?
  createdAt                DateTime @default(now())

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

// ── Labor ────────────────────────────────────────────────────────────────────

model LaborEntry {
  id              String   @id @default(cuid())
  jobId           String
  userId          String   // the worker
  date            DateTime
  hours           Float
  submittedByName String?  // name snapshot of who entered this record
  createdAt       DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

// ── Materials ────────────────────────────────────────────────────────────────

model Material {
  id              String   @id @default(cuid())
  jobId           String
  userId          String
  date            DateTime
  vendor          String?
  description     String
  amount          Decimal  @db.Decimal(12, 2)
  fileUrl         String?
  fileName        String?
  archivedToVault Boolean  @default(false)
  createdAt       DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

// ── Photos ───────────────────────────────────────────────────────────────────

model Photo {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

// ── Notes ────────────────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

// ── Change Orders ────────────────────────────────────────────────────────────

model ChangeOrder {
  id                 String            @id @default(cuid())
  jobId              String
  requestedById      String
  coNumber           Int?
  date               DateTime?
  description        String            @db.Text
  location           String?
  reason             String?
  requestedByName    String?
  estimatedHours     Float?
  estimatedLaborCost Decimal?          @db.Decimal(12, 2)
  estimatedMaterials Decimal?          @db.Decimal(12, 2)
  status             ChangeOrderStatus @default(PENDING)
  adminNotes         String?           @db.Text
  approvedValue      Decimal?          @db.Decimal(12, 2)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  job         Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy User               @relation(fields: [requestedById], references: [id])
  photos      ChangeOrderPhoto[]
}

model ChangeOrderPhoto {
  id            String      @id @default(cuid())
  changeOrderId String
  url           String
  createdAt     DateTime    @default(now())

  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
}

// ── Tasks ────────────────────────────────────────────────────────────────────

model SavedTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User   @relation(fields: [createdById], references: [id])
  tasks     Task[]
}

model Task {
  id           String     @id @default(cuid())
  jobId        String
  savedTaskId  String?
  title        String
  description  String?
  status       TaskStatus @default(OPEN)
  assigneeId   String?
  ballInCourt  String?
  dueDate      DateTime?
  createdById  String
  completedAt  DateTime?
  completedBy  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedTask  SavedTask? @relation(fields: [savedTaskId], references: [id])
  assignee   User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator    User       @relation("TaskCreator", fields: [createdById], references: [id])
  events     TaskEvent[]
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  action    String
  note      String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

// ── Calendar ─────────────────────────────────────────────────────────────────

model CalendarEvent {
  id        String            @id @default(cuid())
  jobId     String?
  userId    String
  type      CalendarEventType
  title     String
  date      DateTime
  endDate   DateTime?
  allDay            Boolean           @default(true)
  note              String?
  recurrence        String?           @default("NONE")
  recurrenceEndDate DateTime?
  googleEventId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  job  Job?  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id])
}

// ── Inspections ───────────────────────────────────────────────────────────────

model Inspection {
  id              String            @id @default(cuid())
  jobId           String
  createdById     String
  type            InspectionType
  dateCalled      DateTime?
  dateScheduled   DateTime?
  inspectorName   String?
  inspectorPhone  String?
  result          InspectionResult?
  correctionNotes String?           @db.Text
  reinspectDate   DateTime?
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy User @relation("InspectionCreator", fields: [createdById], references: [id])
}

// ── RFIs ─────────────────────────────────────────────────────────────────────

model Rfi {
  id            String    @id @default(cuid())
  jobId         String
  submittedById String
  rfiNumber     Int
  subject       String
  description   String?   @db.Text
  submittedTo   String?
  submittedToEmail String?
  status        RfiStatus @default(OPEN)
  dueDate       DateTime?
  answeredDate  DateTime?
  answer        String?   @db.Text
  fileUrl       String?
  fileName      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  job         Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submittedBy User @relation("RfiSubmitter", fields: [submittedById], references: [id])

  @@unique([jobId, rfiNumber])
}

// ── Document Vault ────────────────────────────────────────────────────────────

model Document {
  id           String           @id @default(cuid())
  jobId        String
  uploadedById String
  category     DocumentCategory @default(OTHER)
  name         String
  fileUrl      String
  fileName     String
  fileSize     Int?
  createdAt    DateTime         @default(now())

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("DocumentUploader", fields: [uploadedById], references: [id])
}

// ── Calendar Requests (Teammate → Foreman/Admin approval) ────────────────────

model CalendarRequest {
  id            String                @id @default(cuid())
  jobId         String
  requestedById String
  date          DateTime
  timeOfDay     String?
  description   String
  reason        String?
  status        CalendarRequestStatus @default(PENDING)
  reviewedById  String?
  reviewNotes   String?
  reviewedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  job         Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("CalendarRequestSubmitter", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("CalendarRequestReviewer", fields: [reviewedById], references: [id])
}

// ── Company Settings (singleton) ─────────────────────────────────────────────

model CompanySettings {
  id        String   @id @default("singleton")
  name      String   @default("Oak Ridge Electrical LLC")
  address   String   @default("209 W. River Rd")
  city      String   @default("Hooksett")
  state     String   @default("NH")
  zip       String   @default("03106")
  phone     String   @default("603-660-4651")
  email     String   @default("Justin@oakridgeelectrical.com")
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

// ── Google Integration ────────────────────────────────────────────────────────

model GoogleConnection {
  id            String    @id @default(cuid())
  email         String
  refreshToken  String    @db.Text
  accessToken   String?   @db.Text
  tokenExpiry   DateTime?
  scopes        String    @db.Text
  connectedById String
  connectedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connectedBy User @relation("GoogleConnectionAdmin", fields: [connectedById], references: [id], onDelete: Cascade)
}

// ── Suppliers ─────────────────────────────────────────────────────────────────

model Supplier {
  id              String   @id @default(cuid())
  name            String
  repName         String?
  email           String?
  phone           String?
  accountNumber   String?
  deliveryNotes   String?
  pickupOnly      Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Stock Items ───────────────────────────────────────────────────────────────

model StockItem {
  id              String   @id @default(cuid())
  category        String
  name            String
  lingo           String?
  sku             String?
  unitOfMeasure   String   @default("EA")
  defaultSupplier String?
  isConsumable    Boolean  @default(false)
  variables       Json?    // array of VariableConfig objects
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests StockRequest[]
}

// ── Stock Approval Requests ───────────────────────────────────────────────────

model StockApprovalRequest {
  id              String    @id @default(cuid())
  jobId           String
  requestedById   String
  status          String    @default("PENDING")  // PENDING | APPROVED | REJECTED
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewer    User?  @relation("ApprovalReviewer", fields: [reviewedById], references: [id])
  requests    StockRequest[] @relation("ApprovalRequests")
}

// ── Stock Requests ────────────────────────────────────────────────────────────

model StockRequest {
  id                String    @id @default(cuid())
  jobId             String
  userId            String
  stockItemId       String?
  customItemName    String?
  customCategory    String?
  variables         Json?     // { key: value } for each selected variable
  quantity          Float     @default(1)
  quantityUnit      String?
  note              String?
  deliveryMethod    String    @default("PICKUP") // PICKUP | DELIVERY_SITE | DELIVERY_SHOP
  status            String    @default("PENDING") // PENDING | SENT | CANCELLED | PENDING_APPROVAL
  orderDate         DateTime  @default(now())
  createdAt         DateTime  @default(now())
  conductorGroupId  String?
  saveToMasterList      Boolean   @default(false)
  isConsumableOverride  Boolean   @default(false)
  approvalRequestId String?

  job             Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id])
  stockItem       StockItem?            @relation(fields: [stockItemId], references: [id])
  approvalRequest StockApprovalRequest? @relation("ApprovalRequests", fields: [approvalRequestId], references: [id])
}

// ── Stock Orders ──────────────────────────────────────────────────────────────

model StockOrder {
  id             String   @id @default(cuid())
  jobId          String
  supplierName   String?
  supplierEmail  String?
  deliveryMethod String?
  poNumber       String?
  deliveryNotes  String?
  items          Json     // snapshot of items ordered
  sentAt         DateTime @default(now())
  sentById       String
  createdAt      DateTime @default(now())

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sentBy User @relation("StockOrderSender", fields: [sentById], references: [id])
}

// ── User Permissions ──────────────────────────────────────────────────────────

model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  permission  String   // "ORDERING"
  scope       String   // "GLOBAL" | "JOB"
  jobId       String?
  grantedById String
  createdAt   DateTime @default(now())

  user      User  @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User  @relation("GrantedPermissions", fields: [grantedById], references: [id])
  job       Job?  @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ── Estimates ─────────────────────────────────────────────────────────────────

model Estimate {
  id                  String         @id @default(cuid())
  jobId               String?        @unique
  job                 Job?           @relation(fields: [jobId], references: [id])
  estimateNumber      String         @unique
  name                String
  status              EstimateStatus @default(DRAFT)
  clientName          String?
  address             String?
  jobNumberAssigned   String?
  laborRate           Float          @default(41.50)
  bulkMarkup          Float          @default(0.085)
  lightMarkup         Float          @default(0.05)
  permitMarkup        Float          @default(0.05)
  subMarkup           Float          @default(0.03)
  overhead            Float          @default(0.10)
  profit              Float          @default(0.12)
  nonProd             Float          @default(0.0)
  designFeePct        Float          @default(0.0)
  designFeeUserId     String?
  designFeeUser       User?          @relation("EstimateDesignFee", fields: [designFeeUserId], references: [id])
  conditionMult       Float          @default(1.0)
  heightAdj           Boolean        @default(false)
  takeoffItems        Json           @default("[]")
  assemblies          Json           @default("[]")
  panelItems          Json           @default("[]")
  permits             Json           @default("[]")
  subs                Json           @default("[]")
  notes               String?        @db.Text
  awardedAt           DateTime?
  createdById         String
  createdBy           User           @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  drawings            TakeoffDrawing[]
  counterAreas        CounterArea[]
}

model TakeoffDrawing {
  id          String   @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name        String
  pageCount   Int      @default(1)
  currentPage Int      @default(1)
  pxPerFoot   Float?
  scaleSet    Boolean  @default(false)
  markups     Json     @default("[]")
  runTypes    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CounterArea {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name       String   @default("Area 1")
  counts     Json     @default("{}")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
